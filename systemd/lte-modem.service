[Unit]
Description=ltemod Uplink Manager (LTE / Ethernet / WiFi-client)
Documentation=https://github.com/frlvmxm-droid/ltemod
After=network.target NetworkManager.service ModemManager.service
Wants=NetworkManager.service ModemManager.service

[Service]
Type=oneshot
RemainAfterExit=yes

EnvironmentFile=/etc/ltemod/ltemod.conf

# Запустить uplink в зависимости от UPLINK_MODE + настроить маршрутизацию
ExecStart=/usr/local/bin/ltemod/setup-uplink.sh start

# Остановить uplink при выходе
ExecStop=/usr/local/bin/ltemod/setup-uplink.sh stop

Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=3

TimeoutStartSec=120
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=lte-modem

[Install]
WantedBy=multi-user.target
