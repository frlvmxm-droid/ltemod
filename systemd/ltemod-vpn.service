[Unit]
Description=ltemod VPN auto-start (reads VPN_PROTO from ltemod.conf)
Documentation=https://github.com/frlvmxm-droid/ltemod
After=lte-modem.service
Requires=lte-modem.service
ConditionFileNotEmpty=/etc/ltemod/ltemod.conf

[Service]
Type=oneshot
RemainAfterExit=yes

# Читает VPN_PROTO из конфига и запускает нужный туннель.
# VPN_PROTO="none" — сервис завершается без ошибки (VPN не нужен).
# Если конфиг туннеля не установлен — vpn-toggle вернёт ошибку, сервис перезапустится.
ExecStart=/bin/bash -c '\
    . /etc/ltemod/ltemod.conf; \
    [[ "${VPN_PROTO:-none}" == "none" ]] && exit 0; \
    exec /usr/local/bin/ltemod/vpn-toggle.sh "$VPN_PROTO" on'

ExecStop=/usr/local/bin/ltemod/vpn-toggle.sh off

Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5

TimeoutStartSec=90
TimeoutStopSec=30

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ltemod-vpn

[Install]
WantedBy=multi-user.target
