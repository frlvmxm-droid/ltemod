[Unit]
Description=WiFi Access Point (hostapd + dnsmasq) — ltemod
Documentation=https://github.com/frlvmxm-droid/ltemod
After=network.target NetworkManager.service
Wants=NetworkManager.service
# Запускать только если WiFi интерфейс присутствует
ConditionPathExists=/sys/class/net/wlan0

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/etc/ltemod/ltemod.conf
ExecStart=/usr/local/bin/ltemod/setup-ap.sh start
ExecStop=/usr/local/bin/ltemod/setup-ap.sh stop
ExecReload=/usr/local/bin/ltemod/setup-ap.sh restart
Restart=on-failure
RestartSec=10
StartLimitIntervalSec=60
StartLimitBurst=3

TimeoutStartSec=60
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
