## hostapd 2.4 GHz AP шаблон для Orange Pi 3 LTS (AP6256 / BCM4345 / brcmfmac)
## Заполняется автоматически setup-ap.sh из ltemod.conf
## НЕ редактировать вручную — изменения будут перезаписаны

interface=WIFI_AP_IFACE_PLACEHOLDER
driver=nl80211
ssid=WIFI_AP_SSID_PLACEHOLDER

# 2.4 GHz
hw_mode=g
channel=WIFI_AP_CHANNEL_2G_PLACEHOLDER
ieee80211n=1
# brcmfmac не поддерживает HT40 scan — только HT20 (20MHz канал)
ht_capab=[SHORT-GI-20]
wmm_enabled=1

# noscan: отключить обязательное сканирование соседей перед запуском AP
# необходимо для brcmfmac (AP6256/BCM4345) — без этого hostapd падает с ret=-5
noscan=1

# Страна: устанавливается через iw reg, здесь не задаём чтобы не вызывать
# принудительный regulatory scan (ieee80211d=1 + country_code = ошибка на brcmfmac)
# country_code=RU  — установить отдельно: sudo iw reg set RU

# Безопасность WPA2
auth_algs=1
wpa=2
wpa_passphrase=WIFI_AP_PASSWORD_PLACEHOLDER
wpa_key_mgmt=WPA-PSK
wpa_pairwise=TKIP CCMP
rsn_pairwise=CCMP

# Скрыть SSID: 0 — видимая сеть, 1 — скрытая
ignore_broadcast_ssid=0

# Разрешить клиентам видеть друг друга (0 — изолировать клиентов)
ap_isolate=0
