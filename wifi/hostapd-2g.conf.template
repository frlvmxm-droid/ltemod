## hostapd 2.4 GHz AP шаблон для Orange Pi 3 LTS (AP6256 / BCM4345 / brcmfmac)
## Заполняется автоматически setup-ap.sh из ltemod.conf
## НЕ редактировать вручную — изменения будут перезаписаны

interface=WIFI_AP_IFACE_PLACEHOLDER
driver=nl80211
ssid=WIFI_AP_SSID_PLACEHOLDER

hw_mode=g
channel=WIFI_AP_CHANNEL_2G_PLACEHOLDER
wmm_enabled=1

# Примечание: ieee80211n=1 отключён — brcmfmac (AP6256/BCM4345) вызывает
# HT_SCAN при включённом N-режиме, что падает с ret=-5 на этом драйвере.
# Скорость: до 54 Mbps (802.11g). Для N-режима нужен патч драйвера.

# Безопасность WPA2
auth_algs=1
wpa=2
wpa_passphrase=WIFI_AP_PASSWORD_PLACEHOLDER
wpa_key_mgmt=WPA-PSK
wpa_pairwise=TKIP CCMP
rsn_pairwise=CCMP

ignore_broadcast_ssid=0
ap_isolate=0
